{
  "name": "travel-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "eval:record": "tsx --env-file-if-exists=.env.local eval/record.ts",
    "eval": "tsx --env-file-if-exists=.env.local eval/run.ts",
