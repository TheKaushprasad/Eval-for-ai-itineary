# Which LLM writes itineraries: openai (default) | gemini | groq | openrouter | ollama.
# Gemini and Groq have free tiers; Ollama runs locally. Defaults per provider live in lib/ai.ts.
LLM_PROVIDER=
LLM_MODEL=
# Optional reasoning effort for reasoning models: minimal | low | medium | high (lower = cheaper)
LLM_REASONING_EFFORT=

# Keys: only the provider(s) you use
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# OLLAMA_URL=http://localhost:11434/v1

# Web research uses OpenAI's web_search tool (paid). On by default only when LLM_PROVIDER=openai.
# RESEARCH=on|off
OPENAI_MODEL=
OPENAI_RESEARCH_MODEL=

# Flights (optional — falls back to web-search estimates). Use a duffel_test_ token.
DUFFEL_ACCESS_TOKEN=

# Email (optional — skipped if unset). onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Trip Planner <onboarding@resend.dev>"

# OpenStreetMap etiquette: identify your app with a real contact or repo URL.
# Nominatim answers 403 to placeholder agents such as "(you@example.com)"; leave empty to use the app default.
NOMINATIM_USER_AGENT=
# Optional: pin one Overpass server instead of the built-in mirror list
OVERPASS_URL=

# Eval harness (npm run eval). The judge defaults to the generator's provider with a different
# model; a different provider (e.g. generate with gemini, judge with groq) is better still.
EVAL_JUDGE_PROVIDER=
EVAL_JUDGE_MODEL=
# Exchange rate for showing cost per itinerary in rupees (default 88)
EVAL_USD_INR=

# Public demo protection (see README "Deploying the demo")
# PLANNER_MODE: open (default, local dev) | code (needs DEMO_ACCESS_CODE) | examples (no live calls)
PLANNER_MODE=
DEMO_ACCESS_CODE=
# Daily limits for live plans (defaults when not open: 3 per visitor, 20 total)
RATE_LIMIT_PER_IP=
DAILY_LIMIT=
