# Required
OPENAI_API_KEY=
# Optional: model overrides (default gpt-5)
OPENAI_MODEL=
OPENAI_RESEARCH_MODEL=

# Flights (optional — falls back to web-search estimates). Use a duffel_test_ token.
DUFFEL_ACCESS_TOKEN=

# Email (optional — skipped if unset). onboarding@resend.dev only delivers to your own Resend account email.
RESEND_API_KEY=
EMAIL_FROM="Trip Planner <onboarding@resend.dev>"

# OpenStreetMap etiquette: identify your app
NOMINATIM_USER_AGENT="ai-travel-itinerary-planner/0.1 (you@example.com)"
# Optional: pin one Overpass server instead of the built-in mirror list
OVERPASS_URL=

# Eval harness (npm run eval). The judge must differ from OPENAI_MODEL (default gpt-5-mini).
EVAL_JUDGE_MODEL=
# Exchange rate for showing cost per itinerary in rupees (default 88)
EVAL_USD_INR=
